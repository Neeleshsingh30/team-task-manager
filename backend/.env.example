DATABASE_URL=postgresql+psycopg://postgres:<URL_ENCODED_PASSWORD>@localhost:5432/team_task_manager
SOURCE_DATABASE_URL=
SUPABASE_DATABASE_URL=
BACKUP_FILE=
PG_RESTORE_PATH=
PG_DUMP_PATH=
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
AUTH_SECRET_KEY=replace-with-a-long-random-secret-before-deploying
ACCESS_TOKEN_MINUTES=720
FRONTEND_BASE_URL=http://localhost:5173

# Recommended on Render Free: Gmail API over HTTPS (no custom sending domain required).
# Enable Gmail API in Google Cloud and authorize the sender account with gmail.send.
GMAIL_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GMAIL_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GMAIL_REFRESH_TOKEN=YOUR_GOOGLE_OAUTH_REFRESH_TOKEN
GMAIL_SENDER_EMAIL=your-sender@gmail.com

# Alternative: Resend API over HTTPS. Real recipients require a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=Team Task Manager <invites@your-verified-domain.com>

# Alternative: SMTP works locally and on paid Render services.
# Render Free blocks outbound SMTP ports 25, 465, and 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
SMTP_FROM_EMAIL=YOUR_GMAIL_ADDRESS
SMTP_FROM_NAME=Team Task Manager
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15

# Set true only if this Render backend runs on a paid plan and uses Gmail SMTP.
ALLOW_RENDER_SMTP=false
