DATABASE_URL=postgresql+psycopg://postgres:<URL_ENCODED_PASSWORD>@localhost:5432/team_task_manager
SOURCE_DATABASE_URL=
SUPABASE_DATABASE_URL=
BACKUP_FILE=
PG_RESTORE_PATH=
PG_DUMP_PATH=
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
AUTH_SECRET_KEY=replace-with-a-long-random-secret-before-deploying
ACCESS_TOKEN_MINUTES=720
FRONTEND_BASE_URL=http://localhost:5173

# Optional SMTP settings for sending workspace invitations by email.
# Set all SMTP_* credentials to enable delivery; otherwise the app provides a copyable link.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
SMTP_FROM_EMAIL=YOUR_GMAIL_ADDRESS
SMTP_FROM_NAME=Team Task Manager
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15